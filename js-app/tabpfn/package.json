{
  "name": "@sap-ai-sdk/tabpfn",
  "version": "2.13.0",
  "description": "This package provides a client for the TabPFN foundation model for tabular prediction via in-context learning.",
  "license": "Apache-2.0",
  "keywords": [
    "sap-ai-sdk",
    "ai-api",
    "tabpfn"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/tabpfn"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "openapi-generator --generateESM --clearOutputDir -i ./src/spec/tabpfn-predict-json.json -o ./src/client -s ./src/spec/options-per-service.json && openapi-generator --generateESM -i ./src/spec/tabpfn-predict-multipart.json -o ./src/client -s ./src/spec/options-per-service.json",
    "pregenerate": "pnpm postprocess-spec",
    "postgenerate": "pnpm update-imports && pnpm make-tabpfn-internal && pnpm make-tabpfn-multipart-internal && pnpm lint:fix",
    "postprocess-spec": "redocly bundle ./src/spec/tabpfnopenapispecs.yaml --overlay=./src/spec/tabpfn-predict-overlay.yaml --remove-unused-components --output ./src/spec/tabpfn-predict.json && node ./scripts/postprocess-tabpfn-spec.ts ./src/spec/tabpfn-predict.json",
    "update-imports": "node ./scripts/update-imports.ts ./src/client",
    "make-tabpfn-internal": "node ./scripts/postgenerate-tabpfn.ts ./src/client/tabpfn/inference-api.ts",
    "make-tabpfn-multipart-internal": "node ./scripts/postgenerate-tabpfn.ts ./src/client/tabpfn-multipart/inference-api.ts",
    "postinstall": "pnpm build",
    "test": "node --test 'src/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@sap-ai-sdk/ai-api": "^2.16.0",
    "@sap-ai-sdk/core": "^2.16.0",
    "@sap-cloud-sdk/connectivity": "catalog:",
    "@sap-cloud-sdk/http-client": "catalog:",
    "@sap-cloud-sdk/util": "catalog:"
  },
  "devDependencies": {
    "@redocly/cli": "^2.64.0",
    "@sap-cloud-sdk/openapi-generator": "catalog:",
    "typescript": "catalog:"
  }
}
