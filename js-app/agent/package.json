{
  "name": "financial-mock-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/agent.ts"
    },
    "./odata-client/API_FINPLANNINGENTRYITEM_SRV": {
      "types": "./src/generated/API_FINPLANNINGENTRYITEM_SRV/index.ts",
      "default": "./src/generated/API_FINPLANNINGENTRYITEM_SRV/index.ts"
    },
    "./odata-client/API_JOURNALENTRYITEMBASIC_SRV": {
      "types": "./src/generated/API_JOURNALENTRYITEMBASIC_SRV/index.ts",
      "default": "./src/generated/API_JOURNALENTRYITEMBASIC_SRV/index.ts"
    },
    "./prefetch": {
      "default": "./src/ai-core-prefetch.ts"
    }
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "query:quarterly-budget": "tsx --env-file-if-exists=../../.env src/cli.ts \"Show me the quarterly budget for cost center A1000 for the last 12 months.\"",
    "query:monthly-costs": "tsx --env-file-if-exists=../../.env src/cli.ts \"Show me the monthly cost for cost center A1000 for the last 12 months.\"",
    "query:forecast": "tsx --env-file-if-exists=../../.env src/cli.ts \"Forecast: plan the budget for cost center A1000 for the next 12 months based on historical data.\"",
    "query:rpt": "tsx --env-file-if-exists=../../.env src/cli.ts \"Load historical and planned data for cost center A1000 into one session table or view, then use run_rpt_prediction to predict amountInGlobalCurrency.\"",
    "test": "node --import tsx --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@langchain/langgraph-checkpoint": "^1.2.0",
    "@sap-ai-sdk/ai-api": "^2.17.0",
    "@sap-ai-sdk/langchain": "^2.17.0",
    "@sap-ai-sdk/rpt": "^2.17.0",
    "@sap-ai-sdk/tabpfn": "workspace:*",
    "@sap-cloud-sdk/odata-v2": "catalog:",
    "@sap-cloud-sdk/resilience": "catalog:",
    "@sap-cloud-sdk/util": "catalog:",
    "bignumber.js": "^11.1.5",
    "langchain": "^1.5.18",
    "moment": "^2.31.0",
    "tsx": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@langchain/core": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@langchain/core": "catalog:",
    "@sap-cloud-sdk/generator": "catalog:",
    "purchase-order-mock-server": "workspace:*",
    "typescript": "catalog:"
  }
}
