{
  "name": "purchase-order-mock-server",
  "version": "1.0.0",
  "description": "Mock server for SAP Purchase Order service",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/app.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "generate-data": "node src/generation/generate-mock-data.ts",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@sap-cloud-sdk/util": "catalog:",
    "d3-random": "^3.0.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/d3-random": "^3.0.4",
    "typescript": "catalog:"
  }
}
